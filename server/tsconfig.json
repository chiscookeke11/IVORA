{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "./**/*.ts",
    "../src/lib/**/*.ts",
    "../src/models/**/*.ts",
    "../src/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
