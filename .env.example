# ──────────────────────────────────────────────
# IVORA — Environment Variables Template
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# OpenAI Realtime API
OPENAI_API_KEY=sk-your-key-here

# Twilio (Phone Number & Streaming)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# MongoDB
MONGODB_URI=

# WebSocket Server
WS_PORT=8080
PUBLIC_WS_URL=wss://your-ngrok-url
# ClubKash for verifying if the IUC is real or not
CLUBKASH_USERID=
CLUBKASH_API_KEY=
# Human Agent Transfer
AGENT_PHONE_NUMBER=+44...
