# ──────────────────────────────────────────────
# IVORA — Environment Variables Template
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# OpenAI Realtime API
OPENAI_API_KEY=sk-your-key-here

# Twilio (Phone Number & Streaming)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# VTpass (Sandbox for Pay TV verification)
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com

# MongoDB
MONGODB_URI=

# WebSocket Server
WS_PORT=8080
PUBLIC_WS_URL=wss://your-ngrok-url

# Human Agent Transfer
AGENT_PHONE_NUMBER=+44...
